# =================================================================
# nvariant Environment Configuration
# =================================================================
# Copy this file to .env and configure your local environment

# -------------------------------------------------------------
# Core Application Settings
# -------------------------------------------------------------
NODE_ENV=development
APP_NAME=nvariant
APP_VERSION=2.0.0
LOG_LEVEL=info

# -------------------------------------------------------------
# Service Discovery & Networking
# -------------------------------------------------------------
API_BASE_URL=http://localhost:3000
CANONICAL_API_PORT=3000
CONTRACT_REGISTRY_PORT=3001
ENFORCEMENT_PORT=3002
LINEAGE_PORT=3003
OBSERVATION_PORT=3004

# Internal service communication
INTERNAL_API_URL=http://localhost:3000
SERVICE_TIMEOUT=30000

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# PostgreSQL (Primary Database)
DATABASE_URL=postgresql://nvariant:password@localhost:5432/nvariant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nvariant
POSTGRES_PASSWORD=password
POSTGRES_DB=nvariant

# Redis (Caching & Sessions)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
SESSION_SECRET=your-session-secret-change-this

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# -------------------------------------------------------------
# External Service Integration
# -------------------------------------------------------------
# AWS Configuration (if using AWS services)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=nvariant-data

# Monitoring & Observability
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DATADOG_API_KEY=your-datadog-api-key

# -------------------------------------------------------------
# Feature Flags & Configuration
# -------------------------------------------------------------
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_DEBUG_LOGS=false
ENABLE_API_DOCS=true

# ML Advisory Features
ENABLE_ML_ADVISORY=true
ML_MODEL_ENDPOINT=http://localhost:5000

# Contract Enforcement
ENABLE_STRICT_VALIDATION=false
CONTRACT_CACHE_TTL=3600

# -------------------------------------------------------------
# Development Tools
# -------------------------------------------------------------
# Hot Reloading
ENABLE_HOT_RELOAD=true

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# Development Database Seeding
SEED_DATABASE=true
ENABLE_TEST_DATA=true

# -------------------------------------------------------------
# Container & Orchestration
# -------------------------------------------------------------
# Docker Configuration
DOCKER_REGISTRY=docker.io
IMAGE_TAG=latest

# Kubernetes Namespace (for deployed environments)
KUBERNETES_NAMESPACE=nvariant-dev

# -------------------------------------------------------------
# Monitoring & Health Checks
# -------------------------------------------------------------
HEALTH_CHECK_INTERVAL=30
METRICS_PORT=9090
PROMETHEUS_ENDPOINT=/metrics

# -------------------------------------------------------------
# Data Processing
# -------------------------------------------------------------
# Batch Processing
BATCH_SIZE=1000
PROCESSING_CONCURRENCY=4

# Data Retention
DATA_RETENTION_DAYS=30
LOG_RETENTION_DAYS=7

# -------------------------------------------------------------
# Notifications & Alerts
# -------------------------------------------------------------
# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# -------------------------------------------------------------
# Performance Tuning
# -------------------------------------------------------------
# Connection Pooling
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30000

# Caching
CACHE_TTL=3600
ENABLE_QUERY_CACHE=true

# Memory Limits
NODE_OPTIONS=--max-old-space-size=4096
